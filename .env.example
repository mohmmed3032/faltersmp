# Discord webhook URL for application submissions
# Get this from Server Settings > Integrations > Webhooks
# NEVER commit your actual webhook URL — only this .env.example should be tracked
DISCORD_WEBHOOK_URL=

# Database URL for Vercel Postgres / Neon
# Format: postgres://username:password@host/database?sslmode=require
DATABASE_URL=

# Admin password for /admin panel
ADMIN_PASSWORD=password

# Secret for signing admin session cookies (any random string, 32+ chars)
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=itsredfoxisthebestdesignerintheworld
